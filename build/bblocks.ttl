<https://raw.githubusercontent.com/ogcincubator/bblocks-ogcapi-common/undefined/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - OGC API Common" ;
    dct:abstract """Building blocks for OGC API - Common.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """OGC API - Common is a multi-part standard that documents the set of common practices and 
shared requirements that have emerged from the development of Resource Oriented Architectures 
and Web APIs within the OGC. Standards developers will use these building-blocks in the 
construction of other OGC Standards that relate to Web APIs. The result is a modular suite 
of coherent API standards which can be adapted by a system designer for the unique requirements 
of their system. As such, this OGC API Standard serves as the "OWS Common" standard for 
resource-oriented OGC APIs. 

Consistent with the architecture of the Web, this specification uses a resource architecture 
that conforms to principles of Representational State Transfer (REST).

This OGC API Standard establishes a common pattern that is based on OpenAPI. 
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-09-16T11:20:57.046590"^^xsd:dateTime ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.api.common.part1.paths.Conformance>,
        <bblocks://ogc.api.common.part1.paths.LandingPage>,
        <bblocks://ogc.api.common.part1.responses.ConformanceDeclaration>,
        <bblocks://ogc.api.common.part1.responses.Exception>,
        <bblocks://ogc.api.common.part1.responses.LandingPage>,
        <bblocks://ogc.api.common.part1.schemas.confClasses>,
        <bblocks://ogc.api.common.part1.schemas.exception>,
        <bblocks://ogc.api.common.part1.schemas.landingPage>,
        <bblocks://ogc.api.common.part1.schemas.link>,
        <bblocks://ogc.api.common.part1.schemas.queryParamValueBoolean>,
        <bblocks://ogc.api.common.part1.schemas.queryParamValueDecimal>,
        <bblocks://ogc.api.common.part1.schemas.queryParamValueDouble>,
        <bblocks://ogc.api.common.part1.schemas.queryParamValueInteger>,
        <bblocks://ogc.api.common.part1.schemas.queryParamValueList> ;
    skos:prefLabel "Building Blocks - OGC API Common" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://raw.githubusercontent.com/ogcincubator/bblocks-ogcapi-common/undefined/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://raw.githubusercontent.com/ogcincubator/bblocks-ogcapi-common/undefined/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://raw.githubusercontent.com/ogcincubator/bblocks-ogcapi-common/undefined/build/bblocks.jsonld> ] ;
    foaf:homepage <https://raw.githubusercontent.com/ogcincubator/bblocks-ogcapi-common/undefined/> ;
    bblocks:hasValidationReport <https://raw.githubusercontent.com/ogcincubator/bblocks-ogcapi-common/undefined/build/tests/report.html> .

