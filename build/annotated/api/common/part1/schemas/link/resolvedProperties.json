{"defs":{},"properties":[{"path":["href"],"id":"http://www.w3.org/ns/oa#hasTarget","jsonld_type":"@id","description":"Supplies the URI to a remote resource (or resource fragment).","required":true,"schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://www.w3.org/ns/oa#hasTarget"},{"path":["rel"],"id":"http://www.iana.org/assignments/relation","jsonld_type":"@id","description":"The type or semantics of the relation.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://www.iana.org/assignments/relation"},{"path":["type"],"id":"http://purl.org/dc/terms/type","description":"A hint indicating what the media type of the result of dereferencing the link should be.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://purl.org/dc/terms/type"},{"path":["hreflang"],"id":"http://purl.org/dc/terms/language","description":"A hint indicating what the language of the result of dereferencing the link should be.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://purl.org/dc/terms/language"},{"path":["title"],"id":"http://www.w3.org/2000/01/rdf-schema#label","description":"Used to label the destination of a link such that it can be used as a human-readable identifier.","schema_type":"string","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["length"],"id":"http://purl.org/dc/terms/extent","schema_type":"integer","sources":["bblocks://ogc.api.common.part1.schemas.link"],"effectiveId":"http://purl.org/dc/terms/extent"}]}